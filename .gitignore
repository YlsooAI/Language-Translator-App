*.pyo
*.pyd
*.egg-info/
.Python
pip-log.txt
pip-delete-this-directory.txt

# JavaScript/Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.nuxt
.next
.cache/
.temp/

# Java specific
*.jar
*.war
*.ear
hs_err_pid*

